{
  "name": "smart-it-helpdesk",
  "version": "1.0.0",
  "private": true,
  "description": "Smart IT Helpdesk for System Reliability Management",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/src/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node server/scripts/databaseCommand.js migrate development",
    "db:seed": "node server/scripts/databaseCommand.js seed development",
    "worker:sla": "node server/src/workers/slaWorker.js",
    "test": "node --test server/tests/unit/*.test.js server/tests/api/*.test.js",
    "test:unit": "node --test server/tests/unit/**/*.test.js",
    "test:api": "node --test server/tests/api/**/*.test.js",
    "db:migrate:test": "node server/scripts/databaseCommand.js migrate test",
    "db:check": "node server/scripts/databaseCommand.js check development",
    "db:check:test": "node server/scripts/databaseCommand.js check test",
    "test:integration": "node --test server/tests/integration/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "knex": "^3.1.0",
    "lucide-react": "^0.475.0",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "openid-client": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.14"
  }
}
