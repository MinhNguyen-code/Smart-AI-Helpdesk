# ==============================================================================
# SMART IT HELPDESK - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL 8.x)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sih_new_app
DB_PASSWORD=
DB_NAME=smart_it_helpdesk_new_dev
DB_TEST_NAME=smart_it_helpdesk_new_test
DB_TEST_USER=sih_new_test
DB_TEST_PASSWORD=
# Optional DB_TEST_HOST / DB_TEST_PORT default to DB_HOST / DB_PORT.

# Session Security (Minimum 32 characters random string)
SESSION_SECRET=

# Google OAuth 2.0 / OpenID Connect Credentials
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Allowed Accounts Bootstrap (Comma-separated initial emails)
INITIAL_ADMIN_EMAIL=binmin109@gmail.com
INITIAL_IT_AGENT_EMAIL=nguyenbinhminh.1009.vn@gmail.com
INITIAL_END_USER_EMAIL=nguyenbinhminh.2006.vn@gmail.com

# SLA Worker Settings
SLA_CHECK_INTERVAL_SECONDS=60

# Upload Settings
UPLOAD_DIR=server/private-uploads
MAX_FILE_SIZE_MB=10

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Dedicated schema migration accounts; used only by explicit migration commands.
DB_MIGRATION_USER=sih_new_dev_migrate
DB_MIGRATION_PASSWORD=
DB_TEST_MIGRATION_USER=sih_new_test_migrate
DB_TEST_MIGRATION_PASSWORD=
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
